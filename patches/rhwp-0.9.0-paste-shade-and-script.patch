+        // background-color ? ?? ??(???). ?????? ?? ???? ??.
+        // (?? rgba(?,0) ? ??? ??? ?? ??? ??? ??? ?? ??)
+        let bg = parse_css_value(&css_lower, "background-color")
+            .or_else(|| parse_css_value(&css_lower, "background"));
+        cs.shade_color = crate::model::color::NONE;
+        if let Some(bg) = bg {
+            let v = bg.trim().to_string();
+            let transparent = v == "transparent"
+                || v == "none"
+                || (v.starts_with("rgba")
+                    && v.trim_end_matches(')')
+                        .rsplit(',')
+                        .next()
+                        .and_then(|a| a.trim().parse::<f64>().ok())
+                        .is_some_and(|a| a == 0.0));
+            if !transparent {
+                if let Some(bgr) = css_color_to_hwp_bgr(&v) {
+                    if bgr != 0x00FF_FFFF {
+                        cs.shade_color = bgr;
+                    }
+                }
+            }
+        }
+
+        // vertical-align ? ????????
+        let va = parse_css_value(&css_lower, "vertical-align").unwrap_or_default();
+        cs.superscript = va.trim().starts_with("super");
+        cs.subscript = va.trim().starts_with("sub");
+
         // text-decoration
         let has_underline = css_lower.contains("text-decoration:underline")
