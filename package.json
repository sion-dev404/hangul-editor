{
  "name": "hangul-editor",
  "private": true,
  "version": "2.7.0",
  "description": "한글 문서를 워드 방식으로 편집하는 프로그램",
  "author": "sion-dev404",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "app": "vite build && electron .",
    "fonts": "node tools/fetch-fonts.mjs",
    "dist": "node tools/fetch-fonts.mjs && vite build && electron-builder --win --dir && node tools/make-setup.mjs",
    "setup": "node tools/make-setup.mjs"
  },
  "devDependencies": {
    "@rhwp/core": "^0.9.0",
    "@rhwp/editor": "^0.9.0",
    "docx": "^9.5.1",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "jszip": "^3.10.1",
    "vite": "^6.0.0"
  },
  "build": {
    "appId": "io.github.sion-dev404.hangul-editor",
    "productName": "한글 편집기",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "electronLanguages": [
      "ko",
      "en-US"
    ]
  }
}
